{
  "name": "mypi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "远程可达的个人 Agent：单容器 + 浏览器客户端，能力来自 pi SDK",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server/index.ts",
    "dev": "node --watch src/server/index.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:mobile": "node scripts/mobile-check.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "express": "5.1.0"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.10.1",
    "playwright": "^1.64.1",
    "typescript": "5.9.3"
  }
}
